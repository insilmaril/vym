function foofunction(s) {
  vym.print ("Foofunction output: " +  s); 
  s = "changed par";
  return {a: "ret-value", b: "bla"};
}

par = "I am a parameter!";
vym.print (foofunction(par));
vym.print ("par is now: " + par);
