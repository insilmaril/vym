vym.clearConsole();
map = vym.currentMap();

vym.print("Iterate over selected subtrees");
map.newBranchIteratorSelection("subtrees");

while (b = map.nextBranch("subtrees") )
{
    vym.print ("Current branch: " + b.headingText() );
}

vym.print("Iterate over selected subtrees, deep levels first");
map.newBranchIteratorSelection("subtrees", true);

while (b = map.nextBranch("subtrees") )
{
    vym.print ("Current branch: " + b.headingText() );
}

vym.print("Iterate over complete map");
map.newBranchIteratorMap("completeMap");

while (b = map.nextBranch("completeMap") )
{
    vym.print ("Current branch: " + b.headingText() );
}

vym.print("Iterate over complete map, deep levels first");
map.newBranchIteratorMap("completeMapDeepFirst", true);

while (b = map.nextBranch("completeMapDeepFirst") )
{
    vym.print ("Current branch: " + b.headingText() );
}