vym.clearConsole();
map = vym.currentMap();

il = map.itemList();
il.setModeBranches();

vym.print(il.count() + " items in map");


vym.print("Iterate over complete map");
map.newBranchIteratorMap("completeMap");

while (b = il.nextBranch() )
{
    vym.print (" - Current branch: " + b.headingText() );
}

vym.print("Iterate over complete map, deep levels first");

il.setModeBranches(true);
while (b = il.nextBranch() )
{
    vym.print (" - Current branch: " + b.headingText() );
}

vym.print("Iterate over selected subtrees");
il.setModeSelectedSubtrees();
while (b = il.nextBranch() )
{
    vym.print (" - Current branch: " + b.headingText() );
}

vym.print("Iterate over selected subtrees, deep levels first");
il.setModeSelectedSubtrees(true);

while (b = il.nextBranch() )
{
    vym.print (" - Current branch: " + b.headingText() );
}

vym.print("Iterate over selected branches without subtrees");
il.setModeSelectedBranches();

while (b = il.nextBranch() )
{
    vym.print (" - Current branch: " + b.headingText() );
}
